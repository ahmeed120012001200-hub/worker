{
  "name": "production-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite --config client/vite.config.js",
    "build": "vite --config client/vite.config.js build",
    "dev:worker": "npm run build && wrangler dev",
    "deploy:worker": "npm run build && wrangler deploy",
    "start": "node --env-file-if-exists=.env server/index.js",
    "migrate:supabase": "node --env-file-if-exists=.env server/migrate-sqlite-to-supabase.js"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@supabase/server": "^1.9.0",
    "@supabase/supabase-js": "^2.117.2",
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "vite": "^6.3.5",
    "wrangler": "^4.147.0"
  }
}
